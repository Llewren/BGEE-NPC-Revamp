// Boa and his guards
IF
	Global("WNBoaSpawned","AR0112",0)
THEN
	RESPONSE #100
		CreateCreature("WNBOA",[2156.1224],SW)
		CreateCreature("WNBOG1",[2216.1257],SW)
		CreateCreature("WNBOG2",[2083.1194],S)
		SetGlobal("WNBoaSpawned","AR0112",1)
END

// Give Boa the shield once the quest is under way.
IF
	GlobalGT("WNAjantisQuest","GLOBAL",5)
	Global("WNShieldLocation","GLOBAL",0)
	!Dead("wnboa")
THEN
	RESPONSE #100
		SetGlobal("WNShieldLocation","GLOBAL",1)
		ActionOverride("WNBOA",CreateItem("WNAJSH",0,0,0))
END

// Boa killed while carrying the shield, before Fenathigrast was visited. (On the Fena path, wnboa.baf has already destroyed his shield.)
IF
	Dead("wnboa")
	Global("WNFenaFirst","GLOBAL",0)
	GlobalLT("WNBoaFirst","GLOBAL",5)
	Global("WNShieldLocation","GLOBAL",1)
THEN
	RESPONSE #100
		SetGlobal("WNBoaFirst","GLOBAL",5)
END

// Journal entry once the shield has actually been looted from Boa's body. Buying it sets WNBoaShieldJournal in wnboa.d, so this can't fire twice.
IF
	Dead("wnboa")
	Global("WNBoaFirst","GLOBAL",5)
	PartyHasItem("wnajsh")
	Global("WNBoaShieldJournal","GLOBAL",0)
THEN
	RESPONSE #100
		AddJournalEntry(@108, QUEST)
		SetGlobal("WNBoaShieldJournal","GLOBAL",1)
END

// Boa's guards join any fight with Boa: whether he turns hostile in dialogue, is attacked directly, or is killed outright.
IF
	OR(2)
		Allegiance("wnboa",ENEMY)
		Dead("wnboa")
	Global("WNBoaGuardsHostile","AR0112",0)
THEN
	RESPONSE #100
		SetGlobal("WNBoaGuardsHostile","AR0112",1)
		ActionOverride("WNBOG1",Enemy())
		ActionOverride("WNBOG2",Enemy())
END
