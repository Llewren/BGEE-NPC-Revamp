// Every undead in Fenathigrast's lair (the abominations and Ollera) runs this script.
IF
	Global("WNFenaFight","GLOBAL",1)
	!Allegiance(Myself,ENEMY)
THEN
	RESPONSE #100
		Enemy()
END

// Backup: the original shout response
IF
	Heard("wnfena",1)
	!Allegiance(Myself,ENEMY)
THEN
	RESPONSE #100
		Enemy()
END
